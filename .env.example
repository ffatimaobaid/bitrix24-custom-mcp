# ── Required ──────────────────────────────────────────────────────────────────
# Base URL of your Bitrix24 inbound webhook (must end with /)
# Format: https://<DOMAIN>/rest/<USER_ID>/<WEBHOOK_CODE>/
BITRIX_WEBHOOK_URL=https://yourdomain.bitrix24.com/rest/1/yoursecretcode/

# Long random secret that forms part of your MCP endpoint URL.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MCP_SECRET_PATH=replace-me-with-a-long-random-string

# ── Optional ──────────────────────────────────────────────────────────────────
# Port to listen on (default 8000)
PORT=8000

# ── CRM Write Capabilities (Safety Guards) ────────────────────────────────────
# Set to 'true' to register CRM write tools (crm_add_comment, crm_add_todo, crm_update_item, crm_create_item).
# Defaults to false (strictly read-only).
ENABLE_WRITES=false

# Dedicated write-capable inbound webhook URL (required when ENABLE_WRITES=true).
# The read webhook BITRIX_WEBHOOK_URL is never used for writes.
BITRIX_WRITE_WEBHOOK_URL=https://yourdomain.bitrix24.com/rest/1/yourwritesecret/
